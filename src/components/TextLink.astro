---
interface Props {
  href: string;
  external?: boolean;
  class?: string;
}

const { href, external = false, class: className = "" }: Props = Astro.props;
---

<a
  class:list={["text-link", className]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer noopener" : undefined}
>
  <slot />
</a>
