---
import ZButtonLink from "@/components/zui/ButtonLink";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className,
}: Props = Astro.props;
---

<ZButtonLink href={href} variant={variant} size={size} external={external} className={className}>
  <slot />
</ZButtonLink>
