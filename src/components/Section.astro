---
interface Props {
  tone?: "default" | "surface" | "subtle" | "inverse";
  id?: string;
  class?: string;
}

const { tone = "default", id, class: className = "" }: Props = Astro.props;

const toneClass =
  tone === "inverse"
    ? "site-section--inverse"
    : tone === "surface"
      ? "site-section--surface"
      : tone === "subtle"
        ? "site-section--subtle"
        : "";
---

<section id={id} class:list={["site-section", toneClass, className]}>
  <slot />
</section>
