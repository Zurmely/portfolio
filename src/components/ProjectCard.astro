---
import type { Locale } from "@/i18n/utils";
import ZProjectCard from "@/components/zui/ProjectCard";
import { ui } from "@/data/site";
import { getLocalizedWorkPath } from "@/utils/content";

interface Props {
  locale: Locale;
  entry: {
    slug: string;
    data: {
      title: string;
      summary: string;
      role: string;
      client?: string;
      context?: string;
      publishDate: Date;
    };
  };
}

const { locale, entry }: Props = Astro.props;
const href = getLocalizedWorkPath(locale, entry.slug);
const meta = `${entry.data.client ?? entry.data.context ?? entry.data.role} · ${entry.data.publishDate.getFullYear()}`;
---

<ZProjectCard
  href={href}
  title={entry.data.title}
  summary={entry.data.summary}
  meta={meta}
  placeholder={locale === "pt" ? "Imagem placeholder do projeto" : "Project image placeholder"}
  ctaLabel={ui.sections.readCaseStudy[locale]}
/>
