---
import type { Locale } from "@/i18n/utils";
import Container from "@/components/Container.astro";
import { navigation, siteMeta } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__inner">
      <div>
        <p class="site-footer__title">{siteMeta.name}</p>
        <p class="site-footer__description">{siteMeta.description[locale]}</p>
      </div>
      <nav class="site-footer__nav" aria-label={locale === "pt" ? "Rodapé" : "Footer"}>
        {
          navigation.map((item) => (
            <a class="nav-link" href={item.href[locale]}>
              {item.label[locale]}
            </a>
          ))
        }
      </nav>
      <div class="site-footer__bottom">
        <p class="site-footer__meta">
          © {year}
          {siteMeta.name}
        </p>
        <p class="site-footer__meta">
          {siteMeta.location[locale]}
        </p>
      </div>
    </div>
  </Container>
</footer>
