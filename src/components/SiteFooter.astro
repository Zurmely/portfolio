---
import type { Locale } from "@/i18n/utils";
import Container from "@/components/Container.astro";
import SiteFooterBar from "@/components/zui/SiteFooterBar";
import { navigation, siteMeta } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const year = new Date().getFullYear();
const links = navigation.map((item) => ({
  label: item.label[locale],
  href: item.href[locale],
}));
---

<Container>
  <SiteFooterBar
    title={siteMeta.name}
    description={siteMeta.description[locale]}
    navLabel={locale === "pt" ? "Rodapé" : "Footer"}
    links={links}
    year={year}
    location={siteMeta.location[locale]}
  />
</Container>
