---
import type { Locale } from "@/i18n/utils";
import { getAlternateLocale } from "@/i18n/utils";
import SiteNavbar from "@/components/zui/SiteNavbar";
import MobileNavDrawer from "@/components/zui/MobileNavDrawer";
import { navigation, siteMeta, ui } from "@/data/site";
import { THEME_STORAGE_KEY } from "@/utils/theme-init";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath }: Props = Astro.props;
const alternate = getAlternateLocale(locale);

function buildAlternatePath(path: string, nextLocale: Locale): string {
  const segments = path.split("/").filter(Boolean);
  if (segments.length === 0) return `/${nextLocale}/`;
  segments[0] = nextLocale;
  return `/${segments.join("/")}${path.endsWith("/") ? "/" : ""}`;
}

const items = navigation.map((item) => ({
  label: item.label[locale],
  href: item.href[locale],
}));

const themeLabels = {
  toDark: ui.themeToggle.toDark[locale],
  toLight: ui.themeToggle.toLight[locale],
};

const menuLabel = locale === "pt" ? "Abrir menu" : "Open menu";
---

<div class="site-top-shell">
  <div class="site-container">
    <SiteNavbar
      brand={siteMeta.name}
      homeHref={`/${locale}/`}
      navLabel={locale === "pt" ? "Principal" : "Main"}
      items={items}
      locale={locale}
      alternateHref={buildAlternatePath(currentPath, alternate)}
      themeLabels={themeLabels}
    >
      <MobileNavDrawer client:idle items={items} menuLabel={menuLabel} />
    </SiteNavbar>
  </div>
</div>

<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY, labels: themeLabels }}>
  const toggle = document.querySelector("[data-theme-toggle]");

  function getCurrentTheme() {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function updateToggle(theme) {
    if (!toggle) return;
    const isDark = theme === "dark";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", isDark ? labels.toLight : labels.toDark);
  }

  function setTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    try {
      localStorage.setItem(storageKey, theme);
    } catch {
      /* no-op */
    }
    updateToggle(theme);
  }

  updateToggle(getCurrentTheme());

  toggle?.addEventListener("click", () => {
    setTheme(getCurrentTheme() === "dark" ? "light" : "dark");
  });
</script>

<script is:inline>
  document.querySelectorAll("[data-locale-link]").forEach((link) => {
    link.addEventListener("click", () => {
      const locale = link.getAttribute("data-locale-link");
      if (locale === "pt" || locale === "en") {
        try {
          localStorage.setItem("lang", locale);
        } catch {
          /* no-op */
        }
      }
    });
  });
</script>
