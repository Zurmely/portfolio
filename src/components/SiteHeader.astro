---
import type { Locale } from "@/i18n/utils";
import Container from "@/components/Container.astro";
import LocaleSwitcher from "@/components/LocaleSwitcher.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { navigation, siteMeta } from "@/data/site";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath }: Props = Astro.props;
---

<header class="site-header" data-site-header>
  <Container>
    <div class="site-header__inner">
      <a class="site-header__brand" href={`/${locale}/`}>{siteMeta.name}</a>
      <nav class="site-header__nav" aria-label={locale === "pt" ? "Principal" : "Main"}>
        {
          navigation.map((item) => (
            <a class="nav-link" href={item.href[locale]}>
              {item.label[locale]}
            </a>
          ))
        }
      </nav>
      <div class="site-header__actions">
        <ThemeToggle locale={locale} />
        <LocaleSwitcher locale={locale} currentPath={currentPath} />
        <button
          type="button"
          class="site-header__menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-navigation"
          aria-label={locale === "pt" ? "Abrir menu" : "Open menu"}
        >
          <Icon name="Menu" size={18} />
        </button>
      </div>
    </div>
    <nav
      id="mobile-navigation"
      class="mobile-nav"
      data-mobile-nav
      aria-label={locale === "pt" ? "Menu mobile" : "Mobile menu"}
    >
      {
        navigation.map((item) => (
          <a class="mobile-nav__link" href={item.href[locale]}>
            {item.label[locale]}
          </a>
        ))
      }
    </nav>
  </Container>
</header>
