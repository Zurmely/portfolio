---
import type { Locale } from "@/i18n/utils";
import ExperienceTimeline from "@/components/zui/ExperienceTimeline";
import { ui } from "@/data/site";
import { formatDateRange } from "@/utils/content";

interface Props {
  locale: Locale;
  items: Array<{
    data: {
      role: string;
      organization: string;
      summary: string;
      startDate: Date;
      endDate?: Date;
      current: boolean;
      location?: string;
      achievements: string[];
      skills: string[];
    };
  }>;
}

const { locale, items }: Props = Astro.props;

const timelineItems = items.map((item) => ({
  role: item.data.role,
  organization: item.data.organization,
  location: item.data.location,
  dates: formatDateRange(
    item.data.startDate,
    item.data.endDate,
    locale,
    ui.sections.present[locale],
    item.data.current,
  ),
  currentLabel: item.data.current ? ui.sections.currentRole[locale] : undefined,
  summary: item.data.summary,
  achievements: item.data.achievements,
  skills: item.data.skills,
  highlightsLabel: locale === "pt" ? "Destaques" : "Highlights",
  skillsLabel: locale === "pt" ? "Competências" : "Skills",
}));
---

<ExperienceTimeline items={timelineItems} />
