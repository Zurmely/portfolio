---
import type { Locale } from "@/i18n/utils";
import Icon from "@/components/Icon.astro";
import { ui } from "@/data/site";
import { THEME_STORAGE_KEY } from "@/utils/theme-init";

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const labels = {
  toDark: ui.themeToggle.toDark[locale],
  toLight: ui.themeToggle.toLight[locale],
};
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label={labels.toDark}
>
  <Icon name="Moon" size={18} class="theme-toggle__icon theme-toggle__icon--moon" />
  <Icon name="Sun" size={18} class="theme-toggle__icon theme-toggle__icon--sun" />
</button>

<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY, labels }}>
  const toggle = document.querySelector("[data-theme-toggle]");

  function getCurrentTheme() {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function updateToggle(theme) {
    if (!toggle) return;
    const isDark = theme === "dark";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", isDark ? labels.toLight : labels.toDark);
  }

  function setTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    try {
      localStorage.setItem(storageKey, theme);
    } catch {
      /* no-op */
    }
    updateToggle(theme);
  }

  updateToggle(getCurrentTheme());

  toggle?.addEventListener("click", () => {
    setTheme(getCurrentTheme() === "dark" ? "light" : "dark");
  });
</script>
