---
import PageShell from "@/components/PageShell.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import { ui } from "@/data/site";
---

<PageShell
  locale="pt"
  title={`${ui.sections.notFoundTitle.pt} | Gabriel Zurmely`}
  description={ui.sections.notFoundBody.pt}
  path="/404/"
>
  <Section tone="inverse">
    <Container>
      <div class="site-section__inner">
        <div class="site-section__header">
          <h1 class="site-heading site-heading--hero">{ui.sections.notFoundTitle.pt}</h1>
          <p class="site-lead">{ui.sections.notFoundBody.pt}</p>
          <div class="locale-gateway__actions">
            <ButtonLink href="/pt/">{ui.sections.returnHome.pt}</ButtonLink>
            <ButtonLink href="/en/" variant="secondary">English home</ButtonLink>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</PageShell>
