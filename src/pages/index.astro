---
import Container from "@/components/Container.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import SeoHead from "@/components/SeoHead.astro";
import ThemeInit from "@/components/ThemeInit.astro";
import { ui } from "@/data/site";
import "@/styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <ThemeInit />
    <SeoHead
      locale="pt"
      title={`${ui.localeGateway.title.pt} | Gabriel Zurmely`}
      description={ui.localeGateway.subtitle.pt}
      path="/"
    />
    <script is:inline>
      (function () {
        try {
          const lang = (navigator.language || "").toLowerCase();
          if (lang.startsWith("en")) {
            window.location.replace("/en/");
          }
        } catch {
          /* no-op */
        }
      })();
    </script>
  </head>
  <body class="locale-gateway">
    <Container class="locale-gateway__panel">
      <p class="site-eyebrow">Gabriel Zurmely</p>
      <h1 class="site-heading">{ui.localeGateway.title.pt}</h1>
      <p class="site-lead">{ui.localeGateway.subtitle.pt}</p>
      <div class="locale-gateway__actions">
        <ButtonLink href="/pt/">{ui.localeGateway.continuePt}</ButtonLink>
        <ButtonLink href="/en/" variant="secondary">{ui.localeGateway.continueEn}</ButtonLink>
      </div>
    </Container>
  </body>
</html>

<style>
  .locale-gateway .site-eyebrow,
  .locale-gateway .site-heading,
  .locale-gateway .site-lead {
    color: var(--z-color-text-inverse);
  }
</style>
