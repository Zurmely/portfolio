---
import PageShell from "@/components/PageShell.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import Icon from "@/components/Icon.astro";
import { getCollection } from "astro:content";
import type { Locale } from "@/i18n/utils";
import { locales } from "@/i18n/utils";
import { profile, siteMeta, ui } from "@/data/site";
import { getSiteUrl } from "@/data/site";
import { sortByDateDesc, sortByOrder } from "@/utils/content";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const workItems = sortByOrder(
  (await getCollection("work", ({ data }) => data.locale === locale && !data.draft)).map(
    (entry) => ({
      ...entry,
      slug: entry.id.replace(/\.(md|mdx)$/, ""),
    }),
  ),
);
const experienceItems = sortByDateDesc(
  await getCollection("experience", ({ data }) => data.locale === locale && !data.draft),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteMeta.name,
  jobTitle: locale === "pt" ? "Designer de UX" : "UX Designer",
  url: getSiteUrl(`/${locale}/`),
  sameAs: ["https://github.com/Zurmely"],
  worksFor: {
    "@type": "Organization",
    name: "Inter",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Federal de Minas Gerais",
  },
};
---

<PageShell
  locale={locale}
  title={siteMeta.title[locale]}
  description={siteMeta.description[locale]}
  path={`/${locale}/`}
  jsonLd={jsonLd}
>
  <Section surface="dark">
    <Container dark>
      <div class="section__inner">
        <div class="section__header">
          <p class="section__eyebrow">{siteMeta.name}</p>
          <h1 class="hero__title">{profile.headline[locale]}</h1>
          <p class="hero__lead">{profile.intro[locale]}</p>
          <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-4);">
            <ButtonLink href={`/${locale}/#work`}>{ui.sections.selectedWork[locale]}</ButtonLink>
            <ButtonLink href={`/${locale}/contact/`}>{ui.sections.getInTouch[locale]}</ButtonLink>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section surface="greige-a" id="work">
    <Container>
      <div class="section__inner">
        <div class="section__header">
          <h2 class="section__title">{ui.sections.selectedWork[locale]}</h2>
          <p class="section__lead">
            {
              locale === "pt"
                ? "Projetos de produto, interfaces e fluxos que mostram meu processo de design."
                : "Product, interface, and flow projects that show my design process."
            }
          </p>
        </div>
        <div class="work-grid">
          {workItems.map((entry) => <ProjectCard locale={locale} entry={entry} />)}
        </div>
      </div>
    </Container>
  </Section>

  <Section surface="greige-b">
    <Container>
      <div class="section__inner">
        <div class="section__header">
          <h2 class="section__title">{ui.sections.experience[locale]}</h2>
          <p class="section__lead">
            {
              locale === "pt"
                ? "Trajetória profissional e acadêmica em formato de currículo."
                : "Professional and academic path in a CV-style timeline."
            }
          </p>
        </div>
        <ExperienceList locale={locale} items={experienceItems} />
      </div>
    </Container>
  </Section>

  <Section surface="greige-a">
    <Container>
      <div class="section__inner">
        <div class="section__header">
          <h2 class="section__title">{ui.sections.capabilities[locale]}</h2>
          <p class="section__lead">
            {
              locale === "pt"
                ? "Áreas em que atuo entre descoberta, interface e entrega."
                : "Areas where I work across discovery, interface, and delivery."
            }
          </p>
        </div>
        <div class="feature-grid">
          {
            profile.capabilities[locale].map((item) => (
              <article class="feature-item card">
                <Icon name="Layers" size={32} class="feature-item__icon" />
                <h3 class="feature-item__title">{item.title}</h3>
                <p class="feature-item__body">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <Section surface="greige-b">
    <Container>
      <div class="section__inner">
        <div class="section__header">
          <h2 class="section__title">{ui.sections.contact[locale]}</h2>
          <p class="section__lead">
            {
              locale === "pt"
                ? "Aberto a conversas sobre design, produto e colaboração."
                : "Open to conversations about design, product, and collaboration."
            }
          </p>
          <ButtonLink href={`/${locale}/contact/`}>{ui.sections.getInTouch[locale]}</ButtonLink>
        </div>
      </div>
    </Container>
  </Section>
</PageShell>
