---
import PageShell from "@/components/PageShell.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import FeatureGrid from "@/components/zui/FeatureGrid";
import { Stack } from "@z-ux/ui/stack";
import { getCollection } from "astro:content";
import type { Locale } from "@/i18n/utils";
import { locales } from "@/i18n/utils";
import { profile, siteMeta, ui } from "@/data/site";
import { getSiteUrl } from "@/data/site";
import { sortByDateDesc, sortByOrder } from "@/utils/content";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const workItems = sortByOrder(
  (await getCollection("work", ({ data }) => data.locale === locale && !data.draft)).map(
    (entry) => ({
      ...entry,
      slug: entry.id.replace(/\.(md|mdx)$/, ""),
    }),
  ),
);
const experienceItems = sortByDateDesc(
  await getCollection("experience", ({ data }) => data.locale === locale && !data.draft),
);

const featureIcons = ["Layers", "Lightbulb", "Users"] as const;
const featureItems = profile.capabilities[locale].map((item, index) => ({
  title: item.title,
  description: item.description,
  icon: featureIcons[index] ?? "Layers",
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteMeta.name,
  jobTitle: locale === "pt" ? "Designer de UX" : "UX Designer",
  url: getSiteUrl(`/${locale}/`),
  sameAs: ["https://github.com/Zurmely"],
  worksFor: {
    "@type": "Organization",
    name: "Inter",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Federal de Minas Gerais",
  },
};
---

<PageShell
  locale={locale}
  title={siteMeta.title[locale]}
  description={siteMeta.description[locale]}
  path={`/${locale}/`}
  jsonLd={jsonLd}
>
  <Section tone="inverse">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <p class="site-eyebrow">{siteMeta.name}</p>
          <h1 class="site-heading site-heading--hero">{profile.headline[locale]}</h1>
          <p class="site-lead">{profile.intro[locale]}</p>
          <Stack direction="horizontal" gap="md" className="site-actions">
            <ButtonLink href={`/${locale}/#work`}>{ui.sections.selectedWork[locale]}</ButtonLink>
            <ButtonLink href={`/${locale}/contact/`} variant="secondary">
              {ui.sections.getInTouch[locale]}
            </ButtonLink>
          </Stack>
        </Stack>
      </Stack>
    </Container>
  </Section>

  <Section tone="surface" id="work">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.selectedWork[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Projetos de produto, interfaces e fluxos que mostram meu processo de design."
                : "Product, interface, and flow projects that show my design process."
            }
          </p>
        </Stack>
        <div class="site-grid site-grid--2">
          {workItems.map((entry) => <ProjectCard locale={locale} entry={entry} />)}
        </div>
      </Stack>
    </Container>
  </Section>

  <Section tone="subtle">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.experience[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Trajetória profissional e acadêmica em formato de currículo."
                : "Professional and academic path in a CV-style timeline."
            }
          </p>
        </Stack>
        <ExperienceList locale={locale} items={experienceItems} />
      </Stack>
    </Container>
  </Section>

  <Section tone="surface">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.capabilities[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Áreas em que atuo entre descoberta, interface e entrega."
                : "Areas where I work across discovery, interface, and delivery."
            }
          </p>
        </Stack>
        <FeatureGrid items={featureItems} />
      </Stack>
    </Container>
  </Section>

  <Section tone="subtle">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.contact[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Aberto a conversas sobre design, produto e colaboração."
                : "Open to conversations about design, product, and collaboration."
            }
          </p>
          <ButtonLink href={`/${locale}/contact/`}>{ui.sections.getInTouch[locale]}</ButtonLink>
        </Stack>
      </Stack>
    </Container>
  </Section>
</PageShell>
