---
import PageShell from "@/components/PageShell.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import WorkDialogCard from "@/components/WorkDialogCard.astro";
import ResumeHero from "@/components/zui/ResumeHero";
import ExperienceTabs from "@/components/zui/ExperienceTabs";
import SkillsGrid from "@/components/zui/SkillsGrid";
import ContactList from "@/components/zui/ContactList";
import { Stack } from "@z-ux/ui/stack";
import { getCollection } from "astro:content";
import type { Locale } from "@/i18n/utils";
import { locales } from "@/i18n/utils";
import {
  contactLinks,
  isRenderableLink,
  profile,
  resolveLinkHref,
  siteMeta,
  ui,
} from "@/data/site";
import { getSiteUrl } from "@/data/site";
import { formatDateRange, sortByDateDesc, sortByOrder } from "@/utils/content";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const workItems = sortByOrder(
  (await getCollection("work", ({ data }) => data.locale === locale && !data.draft)).map(
    (entry) => ({
      ...entry,
      slug: entry.id.replace(/\.(md|mdx)$/, ""),
    }),
  ),
);
const experienceItems = sortByDateDesc(
  await getCollection("experience", ({ data }) => data.locale === locale && !data.draft),
);

const professionalItems = experienceItems.filter(
  (item) => item.data.employmentType !== "education",
);
const educationItems = experienceItems.filter((item) => item.data.employmentType === "education");

function mapTimelineItems(items: typeof experienceItems): Array<{
  role: string;
  organization: string;
  location?: string;
  dates: string;
  currentLabel?: string;
  summary: string;
  achievements: string[];
  skills: string[];
  highlightsLabel: string;
  skillsLabel: string;
}> {
  return items.map((item) => ({
    role: item.data.role,
    organization: item.data.organization,
    location: item.data.location,
    dates: formatDateRange(
      item.data.startDate,
      item.data.endDate,
      locale,
      ui.sections.present[locale],
      item.data.current,
    ),
    currentLabel: item.data.current ? ui.sections.currentRole[locale] : undefined,
    summary: item.data.summary,
    achievements: item.data.achievements,
    skills: item.data.skills,
    highlightsLabel: locale === "pt" ? "Destaques" : "Highlights",
    skillsLabel: locale === "pt" ? "Competências" : "Skills",
  }));
}

const featureIcons = ["Layers", "Lightbulb", "Users"] as const;
const capabilityItems = profile.capabilities[locale].map((item, index) => ({
  title: item.title,
  description: item.description,
  icon: featureIcons[index] ?? "Layers",
}));

const aggregatedSkills = [...new Set(experienceItems.flatMap((item) => item.data.skills))].sort();

const contactListItems = contactLinks.filter(isRenderableLink).map((link) => ({
  label: link.label[locale],
  href: resolveLinkHref(link),
  external: link.external,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteMeta.name,
  jobTitle: locale === "pt" ? "Designer de UX" : "UX Designer",
  url: getSiteUrl(`/${locale}/`),
  sameAs: ["https://github.com/Zurmely"],
  worksFor: {
    "@type": "Organization",
    name: "Inter",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Federal de Minas Gerais",
  },
};
---

<PageShell
  locale={locale}
  title={siteMeta.title[locale]}
  description={siteMeta.description[locale]}
  path={`/${locale}/`}
  jsonLd={jsonLd}
>
  <Section id="about">
    <Container>
      <ResumeHero
        name={siteMeta.name}
        headline={profile.headline[locale]}
        intro={profile.intro[locale]}
        location={siteMeta.location[locale]}
        workCtaLabel={ui.sections.selectedWork[locale]}
        contactCtaLabel={ui.sections.getInTouch[locale]}
        workHref={`/${locale}/#work`}
        contactHref={`/${locale}/#contact`}
      />
    </Container>
  </Section>

  <Section id="experience">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.experience[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Trajetória profissional e acadêmica em formato de currículo."
                : "Professional and academic path in a CV-style timeline."
            }
          </p>
        </Stack>
        <ExperienceTabs
          client:visible
          experienceLabel={ui.sections.experience[locale]}
          educationLabel={ui.sections.education[locale]}
          experienceItems={mapTimelineItems(professionalItems)}
          educationItems={mapTimelineItems(educationItems)}
        />
      </Stack>
    </Container>
  </Section>

  <Section id="skills">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.capabilities[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Áreas em que atuo entre descoberta, interface e entrega."
                : "Areas where I work across discovery, interface, and delivery."
            }
          </p>
        </Stack>
        <SkillsGrid
          capabilities={capabilityItems}
          skills={aggregatedSkills}
          skillsLabel={locale === "pt" ? "Competências" : "Skills"}
        />
      </Stack>
    </Container>
  </Section>

  <Section id="work">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.sections.selectedWork[locale]}</h2>
          <p class="site-lead">
            {
              locale === "pt"
                ? "Projetos de produto, interfaces e fluxos que mostram meu processo de design."
                : "Product, interface, and flow projects that show my design process."
            }
          </p>
        </Stack>
        <div class="site-grid site-grid--2">
          {workItems.map((entry) => <WorkDialogCard locale={locale} entry={entry} />)}
        </div>
      </Stack>
    </Container>
  </Section>

  <Section id="contact">
    <Container>
      <Stack direction="vertical" gap="lg" className="site-section__inner">
        <Stack direction="vertical" gap="md" className="site-section__header">
          <h2 class="site-heading">{ui.contactPage.title[locale]}</h2>
          <p class="site-lead">{ui.contactPage.intro[locale]}</p>
        </Stack>
        <ContactList links={contactListItems} note={ui.contactPage.note[locale]} />
      </Stack>
    </Container>
  </Section>
</PageShell>
