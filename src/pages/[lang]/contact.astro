---
import PageShell from "@/components/PageShell.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import ContactLinks from "@/components/ContactLinks.astro";
import type { Locale } from "@/i18n/utils";
import { locales } from "@/i18n/utils";
import { siteMeta, ui } from "@/data/site";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<PageShell
  locale={locale}
  title={`${ui.contactPage.title[locale]} | ${siteMeta.name}`}
  description={ui.contactPage.intro[locale]}
  path={`/${locale}/contact/`}
>
  <Section tone="inverse">
    <Container>
      <div class="site-section__inner">
        <div class="site-section__header">
          <h1 class="site-heading site-heading--hero">{ui.contactPage.title[locale]}</h1>
          <p class="site-lead">{ui.contactPage.intro[locale]}</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="surface">
    <Container>
      <div class="site-section__inner">
        <ContactLinks locale={locale} />
        <p class="site-lead">{ui.contactPage.note[locale]}</p>
      </div>
    </Container>
  </Section>
</PageShell>
