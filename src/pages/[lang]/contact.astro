---
import PageShell from "@/components/PageShell.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import ContactLinks from "@/components/ContactLinks.astro";
import type { Locale } from "@/i18n/utils";
import { locales } from "@/i18n/utils";
import { siteMeta, ui } from "@/data/site";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<PageShell
  locale={locale}
  title={`${ui.contactPage.title[locale]} | ${siteMeta.name}`}
  description={ui.contactPage.intro[locale]}
  path={`/${locale}/contact/`}
>
  <Section surface="dark">
    <Container dark>
      <div class="section__inner">
        <div class="section__header">
          <h1 class="hero__title" style="font-size: var(--font-size-7xl);">
            {ui.contactPage.title[locale]}
          </h1>
          <p class="hero__lead">{ui.contactPage.intro[locale]}</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section surface="greige-a">
    <Container>
      <div class="section__inner">
        <ContactLinks locale={locale} />
        <p class="section__lead">{ui.contactPage.note[locale]}</p>
      </div>
    </Container>
  </Section>
</PageShell>
